{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BroadS3",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "DenyOutsideCorporateNetwork",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {"NotIpAddress": {"aws:SourceIp": ["198.51.100.0/24"]}}
    }
  ]
}
